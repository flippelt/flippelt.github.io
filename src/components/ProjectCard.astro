---
import type { Project } from '../data/projects'

interface Props {
  project: Project
  /** Rótulo acessível da lista de tecnologias (muda com o idioma). */
  techAriaLabel?: string
  /** Borda holográfica — só nas âncoras do ecossistema. */
  shiny?: boolean
  heading?: 'h3' | 'h4'
}

const { project, techAriaLabel = 'Tecnologias', shiny = false, heading = 'h3' } = Astro.props
const Heading = heading
---

<article class:list={['card', { 'card--shiny': shiny }]}>
  <header class="card__head">
    <Heading class="card__name">{project.name}</Heading>
    {project.badge && <span class="card__badge">{project.badge}</span>}
  </header>

  <p class="card__tagline">{project.tagline}</p>
  <p class="card__desc">{project.description}</p>

  <ul class="card__stack" aria-label={techAriaLabel}>
    {project.stack.map((tech) => <li>{tech}</li>)}
  </ul>

  <div class="card__links">
    {
      project.links.map((link) => (
        <a
          class:list={[
            'card__link',
            { 'card__link--primary': link.primary, 'card__link--release': link.release },
          ]}
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label} {link.release ? '⬇' : '↗'}
        </a>
      ))
    }
  </div>
</article>
