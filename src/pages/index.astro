---
import Layout from '../layouts/Layout.astro'
import HomePage from '../components/HomePage.astro'
import LoginGate from '../components/LoginGate.tsx'

const base = import.meta.env.BASE_URL
const enHref = base + 'en/'
---

<Layout locale="pt-br">
  <!-- Antes do primeiro paint: escolha lembrada 'en' → redireciona; sem
       escolha → liga o overlay de login (html[data-gate='show'], que o CSS
       usa para mostrar o .gate e travar o scroll); 'pt-br' → segue direto.
       Crawlers/no-JS nunca veem o gate: o conteúdo está no HTML normalmente. -->
  <script is:inline define:vars={{ enHref }}>
    try {
      var lang = localStorage.getItem('lang')
      if (lang === 'en') location.replace(enHref)
      else if (!lang) document.documentElement.dataset.gate = 'show'
    } catch (e) {
      /* sem storage: segue para o conteúdo em pt-br */
    }
  </script>

  <HomePage locale="pt-br" />

  <div class="gate" role="dialog" aria-modal="true" aria-label="Seleção de idioma / language selection">
    <LoginGate client:load enHref={enHref} />
  </div>
</Layout>
